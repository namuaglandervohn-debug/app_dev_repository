{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/admin/user-accounts.js": {
      "includeFiles": "resources/views/emails/account-welcome.html"
    },
    "api/applications/hired-account.js": {
      "includeFiles": "resources/views/emails/hired-welcome.html"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
